# Copy to /opt/vietlangai/ai-model/.env on the ML host (GPU EC2 recommended).
ML_MT_ENGINE=nllb
ML_MT_MODEL=models/nllb-200-distilled-600M
ML_MT_ADAPTER=models/nllb-ethnic
ML_MODELS_DIR=models
ML_ASR_ENGINE=unloaded
ML_OCR_ENGINE=unloaded
LANGUAGES_CATALOG=/opt/vietlangai/shared/languages.json
REVIEWED_PAIRS=/opt/vietlangai/ai-model/data/reviewed_pairs.csv
PUBLIC_PAIRS=/opt/vietlangai/ai-model/data/public/pairs.csv
HF_HOME=/opt/vietlangai/hf-cache
